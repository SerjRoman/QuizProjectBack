{
    "include": ["src/**/*", "types/declrations/*.d.ts"],
    "exclude": ["./jest.config.js"],
    "compilerOptions": {
        "paths": {
            "#types": ["./src/types/"],
            "#prisma-types": ["./src/generated/prisma/"],
            "@utils": ["./src/utils"],
            "@modules/*": ["./src/modules/*"],
            "@middlewares": ["./src/middlewares"],
            "@errors": ["./src/errors"],
            "@prisma": ["./src/prisma"],
            "@config": ["./src/config"],
            "@common/*": ["./src/common/*"]
        },
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    }
}
