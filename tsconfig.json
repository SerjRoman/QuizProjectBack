{
    "include": ["src/**/*", "types/declrations/*.d.ts"],
    "exclude": ["./jest.config.js"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@src/*": ["src/*"],
            "#types/*": ["src/types/*"],
            "#prisma/*": ["src/generated/*"]
        },
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    }
}
