enum RoomStatus {
  ACTIVE
  FINISHED
  WAITING
}

model Room {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name         String
  status       RoomStatus
  participants QuizParticipant[] @relation(name: "QuizParticipantRoomRelation")
  quizId String @db.ObjectId
  quiz Quiz @relation(fields: [quizId], references: [id], name: "QuizRoomRelation")

  reports Report[] @relation(name: "RoomReportRelation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
