model Question {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  type      QuestionType
  data      Json
  createdAt DateTime     @default(now())
  quiz      Quiz         @relation(fields: [quizId], references: [id])
  quizId    String       @db.ObjectId

  answerAttempts QuizAttemptAnswer[] @relation(name: "QuizAttemptAnswerQuestionRelation")
}

enum QuestionType {
  multiChoice
  singleChoice
}
