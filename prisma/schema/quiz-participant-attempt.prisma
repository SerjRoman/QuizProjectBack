model QuizParticipantAttempt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  participantId String          @unique @db.ObjectId
  participant   QuizParticipant @relation(fields: [participantId], references: [id])
  scored        Float
  timeSpent     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers QuizAttemptAnswer[] @relation(name: "QuizAttemptAnswerAttemptRelation")
}
