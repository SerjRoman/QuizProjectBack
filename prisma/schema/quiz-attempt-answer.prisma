model QuizAttemptAnswer {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sessinQuestionId String          @db.ObjectId
  sessionQuestion  SessionQuestion @relation(fields: [sessinQuestionId], references: [id])

  attemptId String                 @db.ObjectId
  attempt   QuizParticipantAttempt @relation(fields: [attemptId], references: [id], name: "QuizAttemptAnswerAttemptRelation")

  answer Json
  scored Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
